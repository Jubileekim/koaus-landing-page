.language-toggle{position:relative;isolation:isolate;display:grid;width:100px;height:40px;padding:4px;border:1px solid var(--line);grid-template-columns:repeat(2,1fr);align-items:stretch;border-radius:999px;background:rgba(255,255,255,.55);box-shadow:inset 0 0 0 1px rgba(255,255,255,.35);transition:border-color .2s ease,background .2s ease}.language-toggle::before{position:absolute;z-index:1;top:4px;bottom:4px;left:4px;width:46px;border-radius:999px;background:var(--ink);box-shadow:0 4px 12px rgba(17,23,19,.18);content:"";transition:transform .26s cubic-bezier(.2,.8,.2,1)}.language-toggle:has([data-language="en"].is-active)::before{transform:translateX(46px)}.language-toggle button{position:relative;z-index:2;display:grid;border:0;place-items:center;color:var(--muted);background:transparent;border-radius:999px;cursor:pointer;font-size:.72rem;font-weight:850;letter-spacing:.04em;transition:color .22s ease}.language-toggle button.is-active{color:#fff}.language-toggle:hover{border-color:rgba(17,23,19,.34);background:rgba(255,255,255,.78)}.language-toggle:focus-within{outline:3px solid rgba(215,255,104,.55);outline-offset:3px}.language-toggle button:focus-visible{outline:0}.lead-card{max-width:860px;margin:0 auto;background:rgba(255,255,255,.74);border:1px solid rgba(17,23,19,.15);border-radius:28px;padding:clamp(24px,5vw,48px);text-align:left}.lead-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.lead-field{display:grid;gap:8px}.lead-field--full{grid-column:1/-1}.lead-field label{font-size:.86rem;font-weight:800}.lead-field input,.lead-field select,.lead-field textarea{width:100%;border:1px solid rgba(17,23,19,.22);border-radius:14px;background:#fff;padding:14px 15px;color:var(--ink)}.lead-field textarea{resize:vertical}.lead-consent{display:flex;gap:10px;align-items:flex-start;margin:18px 0;font-size:.86rem;color:var(--muted)}.lead-consent input{margin-top:4px}.form-message{min-height:1.5em;margin:12px 0 0;font-weight:800}.form-note{font-size:.78rem;color:var(--muted);margin:10px 0 0}.cta-card .lead-card h3{margin:0 0 8px;font-size:1.6rem}.cta-card .lead-card>p{margin:0 0 24px;text-align:left}.header-actions{flex-wrap:wrap}.audience-note{max-width:820px;margin:0 auto 30px;text-align:center;color:var(--muted)}@media(max-width:900px){.language-toggle{margin-left:auto}.header-actions{gap:6px}.lead-grid{grid-template-columns:1fr}.lead-field--full{grid-column:auto}}@media(max-width:560px){.wordmark span{display:none}.language-toggle{width:92px;height:38px}.language-toggle::before{width:42px}.language-toggle:has([data-language="en"].is-active)::before{transform:translateX(42px)}.lead-card{padding:22px 18px}}@media(prefers-reduced-motion:reduce){.language-toggle,.language-toggle::before,.language-toggle button{transition:none}}

/* Korean typography: smaller display type, roomier reading rhythm */
html[lang="ko"] body {
  line-height: 1.68;
  word-break: keep-all;
  overflow-wrap: break-word;
}

html[lang="ko"] h1 {
  font-size: clamp(2.75rem, 6.2vw, 6.4rem);
  line-height: 1.03;
  letter-spacing: -0.06em;
}

html[lang="ko"] .hero-copy > p:not(.eyebrow) {
  font-size: clamp(0.98rem, 1.45vw, 1.12rem);
  line-height: 1.75;
}

html[lang="ko"] .section-heading h2 {
  font-size: clamp(2.15rem, 4.3vw, 4.55rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
}

html[lang="ko"] .fit-wrap h2 {
  font-size: clamp(2.05rem, 3.9vw, 4.05rem);
  line-height: 1.1;
  letter-spacing: -0.05em;
}

html[lang="ko"] .cta-card > h2 {
  font-size: clamp(2.5rem, 5.9vw, 5.85rem);
  line-height: 1.04;
  letter-spacing: -0.06em;
}

html[lang="ko"] .hero-card h2 {
  font-size: 1.3rem;
  line-height: 1.35;
}

html[lang="ko"] .problem-card h3,
html[lang="ko"] .service-card h3,
html[lang="ko"] .proof-card h3 {
  font-size: 1.25rem;
  line-height: 1.45;
}

html[lang="ko"] .process-step h3 {
  font-size: 1.08rem;
  line-height: 1.45;
}

html[lang="ko"] .cta-card .lead-card h3 {
  font-size: 1.45rem;
  line-height: 1.4;
}

@media (max-width: 560px) {
  html[lang="ko"] h1 {
    font-size: 2.65rem;
    line-height: 1.08;
  }

  html[lang="ko"] .section-heading h2 {
    font-size: 2.2rem;
    line-height: 1.12;
  }

  html[lang="ko"] .fit-wrap h2 {
    font-size: 2.15rem;
  }

  html[lang="ko"] .cta-card > h2 {
    font-size: 2.55rem;
    line-height: 1.08;
  }
}
/* End Korean typography */
