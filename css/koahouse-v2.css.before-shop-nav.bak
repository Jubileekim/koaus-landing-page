.language-toggle{position:relative;isolation:isolate;display:grid;width:100px;height:40px;padding:4px;border:1px solid var(--line);grid-template-columns:repeat(2,1fr);align-items:stretch;border-radius:999px;background:rgba(255,255,255,.55);box-shadow:inset 0 0 0 1px rgba(255,255,255,.35);transition:border-color .2s ease,background .2s ease}.language-toggle::before{position:absolute;z-index:1;top:4px;bottom:4px;left:4px;width:46px;border-radius:999px;background:var(--ink);box-shadow:0 4px 12px rgba(17,23,19,.18);content:"";transition:transform .26s cubic-bezier(.2,.8,.2,1)}.language-toggle:has([data-language="en"].is-active)::before{transform:translateX(46px)}.language-toggle button{position:relative;z-index:2;display:grid;border:0;place-items:center;color:var(--muted);background:transparent;border-radius:999px;cursor:pointer;font-size:.72rem;font-weight:850;letter-spacing:.04em;transition:color .22s ease}.language-toggle button.is-active{color:#fff}.language-toggle:hover{border-color:rgba(17,23,19,.34);background:rgba(255,255,255,.78)}.language-toggle:focus-within{outline:3px solid rgba(215,255,104,.55);outline-offset:3px}.language-toggle button:focus-visible{outline:0}.lead-card{max-width:860px;margin:0 auto;background:rgba(255,255,255,.74);border:1px solid rgba(17,23,19,.15);border-radius:28px;padding:clamp(24px,5vw,48px);text-align:left}.lead-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.lead-field{display:grid;gap:8px}.lead-field--full{grid-column:1/-1}.lead-field label{font-size:.86rem;font-weight:800}.lead-field input,.lead-field select,.lead-field textarea{width:100%;border:1px solid rgba(17,23,19,.22);border-radius:14px;background:#fff;padding:14px 15px;color:var(--ink)}.lead-field textarea{resize:vertical}.lead-consent{display:flex;gap:10px;align-items:flex-start;margin:18px 0;font-size:.86rem;color:var(--muted)}.lead-consent input{margin-top:4px}.form-message{min-height:1.5em;margin:12px 0 0;font-weight:800}.form-note{font-size:.78rem;color:var(--muted);margin:10px 0 0}.cta-card .lead-card h3{margin:0 0 8px;font-size:1.6rem}.cta-card .lead-card>p{margin:0 0 24px;text-align:left}.header-actions{flex-wrap:wrap}.audience-note{max-width:820px;margin:0 auto 30px;text-align:center;color:var(--muted)}@media(max-width:900px){.language-toggle{margin-left:auto}.header-actions{gap:6px}.lead-grid{grid-template-columns:1fr}.lead-field--full{grid-column:auto}}@media(max-width:560px){.wordmark span{display:none}.language-toggle{width:92px;height:38px}.language-toggle::before{width:42px}.language-toggle:has([data-language="en"].is-active)::before{transform:translateX(42px)}.lead-card{padding:22px 18px}}@media(prefers-reduced-motion:reduce){.language-toggle,.language-toggle::before,.language-toggle button{transition:none}}

/* Korean typography: smaller display type, roomier reading rhythm */
html[lang="ko"] body {
  line-height: 1.68;
  word-break: keep-all;
  overflow-wrap: break-word;
}

html[lang="ko"] h1 {
  font-size: clamp(2.75rem, 6.2vw, 6.4rem);
  line-height: 1.03;
  letter-spacing: -0.06em;
}

html[lang="ko"] .hero-copy > p:not(.eyebrow) {
  font-size: clamp(0.98rem, 1.45vw, 1.12rem);
  line-height: 1.75;
}

html[lang="ko"] .section-heading h2 {
  font-size: clamp(2.15rem, 4.3vw, 4.55rem);
  line-height: 1.08;
  letter-spacing: -0.05em;
}

html[lang="ko"] .fit-wrap h2 {
  font-size: clamp(2.05rem, 3.9vw, 4.05rem);
  line-height: 1.1;
  letter-spacing: -0.05em;
}

html[lang="ko"] .cta-card > h2 {
  font-size: clamp(2.5rem, 5.9vw, 5.85rem);
  line-height: 1.04;
  letter-spacing: -0.06em;
}

html[lang="ko"] .hero-card h2 {
  font-size: 1.3rem;
  line-height: 1.35;
}

html[lang="ko"] .problem-card h3,
html[lang="ko"] .service-card h3,
html[lang="ko"] .proof-card h3 {
  font-size: 1.25rem;
  line-height: 1.45;
}

html[lang="ko"] .process-step h3 {
  font-size: 1.08rem;
  line-height: 1.45;
}

html[lang="ko"] .cta-card .lead-card h3 {
  font-size: 1.45rem;
  line-height: 1.4;
}

@media (max-width: 560px) {
  html[lang="ko"] h1 {
    font-size: 2.65rem;
    line-height: 1.08;
  }

  html[lang="ko"] .section-heading h2 {
    font-size: 2.2rem;
    line-height: 1.12;
  }

  html[lang="ko"] .fit-wrap h2 {
    font-size: 2.15rem;
  }

  html[lang="ko"] .cta-card > h2 {
    font-size: 2.55rem;
    line-height: 1.08;
  }
}
/* End Korean typography */

/* English typography: reduced display scale */
html[lang="en"] body {
  line-height: 1.62;
}

html[lang="en"] h1 {
  font-size: clamp(2.9rem, 6.35vw, 6.55rem);
  line-height: 0.98;
  letter-spacing: -0.067em;
}

html[lang="en"] .hero-copy > p:not(.eyebrow) {
  font-size: clamp(0.98rem, 1.5vw, 1.14rem);
  line-height: 1.68;
}

html[lang="en"] .section-heading h2 {
  font-size: clamp(2.25rem, 4.45vw, 4.65rem);
  line-height: 1.02;
  letter-spacing: -0.057em;
}

html[lang="en"] .fit-wrap h2 {
  font-size: clamp(2.15rem, 4vw, 4.15rem);
  line-height: 1.04;
  letter-spacing: -0.055em;
}

html[lang="en"] .cta-card > h2 {
  font-size: clamp(2.65rem, 6vw, 5.95rem);
  line-height: 0.99;
  letter-spacing: -0.065em;
}

html[lang="en"] .hero-card h2 {
  font-size: 1.32rem;
  line-height: 1.28;
}

html[lang="en"] .problem-card h3,
html[lang="en"] .service-card h3,
html[lang="en"] .proof-card h3 {
  font-size: 1.28rem;
  line-height: 1.34;
}

html[lang="en"] .process-step h3 {
  font-size: 1.1rem;
  line-height: 1.35;
}

html[lang="en"] .cta-card .lead-card h3 {
  font-size: 1.48rem;
  line-height: 1.32;
}

@media (max-width: 560px) {
  html[lang="en"] h1 {
    font-size: 2.7rem;
    line-height: 1.02;
  }

  html[lang="en"] .section-heading h2 {
    font-size: 2.25rem;
    line-height: 1.06;
  }

  html[lang="en"] .fit-wrap h2 {
    font-size: 2.2rem;
  }

  html[lang="en"] .cta-card > h2 {
    font-size: 2.6rem;
    line-height: 1.03;
  }
}
/* End English typography */

/* UGC mosaic hero */
.hero--ugc {
  position: relative;
  isolation: isolate;
  min-height: min(900px, calc(100svh - 78px));
  padding: 0;
  overflow: hidden;
  color: #fff;
  background: #080a09;
}

.ugc-mosaic {
  position: absolute;
  z-index: -3;
  inset: -14% -2% -18%;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  transform: scale(1.04);
}

.ugc-column {
  min-width: 0;
  overflow: hidden;
}

.ugc-column--1 { transform: translateY(-4%); }
.ugc-column--2 { transform: translateY(-13%); }
.ugc-column--3 { transform: translateY(-8%); }

.ugc-track {
  display: flex;
  flex-direction: column;
  animation: ugc-vertical-loop var(--ugc-duration) linear infinite;
  animation-direction: var(--ugc-direction);
  will-change: transform;
}

.ugc-loop-set {
  display: grid;
  gap: 10px;
  padding-bottom: 10px;
}

.ugc-card {
  position: relative;
  overflow: hidden;
  aspect-ratio: 9 / 16;
  min-height: 0;
  background: #222;
}

.ugc-card video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: saturate(.88) contrast(1.04);
}

.hero-ugc-shade {
  position: absolute;
  z-index: -2;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(6, 8, 7, .95) 0%, rgba(6, 8, 7, .82) 35%, rgba(6, 8, 7, .32) 70%, rgba(6, 8, 7, .48) 100%),
    linear-gradient(180deg, rgba(6, 8, 7, .26) 0%, rgba(6, 8, 7, .08) 48%, rgba(6, 8, 7, .82) 100%);
}

.hero-ugc-inner {
  min-height: min(900px, calc(100svh - 78px));
  padding-top: clamp(72px, 10vh, 120px);
  padding-bottom: 42px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-ugc-copy {
  width: min(760px, 68%);
  padding-top: 3vh;
}

.hero--ugc h1 {
  max-width: 760px;
  margin: 18px 0 22px;
  text-wrap: balance;
  text-shadow: 0 5px 30px rgba(0, 0, 0, .28);
}

.hero--ugc h1 em {
  display: inline;
  padding: .01em .12em .06em;
  color: var(--ink);
  background: var(--lime);
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

.hero-ugc-body {
  max-width: 650px;
  margin: 0;
  color: rgba(255, 255, 255, .78);
  font-size: clamp(1rem, 1.4vw, 1.14rem);
  line-height: 1.72;
  text-shadow: 0 2px 20px rgba(0, 0, 0, .28);
}

.button--glass {
  border-color: rgba(255, 255, 255, .72);
  color: #fff;
  background: rgba(8, 10, 9, .25);
  backdrop-filter: blur(10px);
}

.button--glass:hover {
  background: rgba(255, 255, 255, .12);
}

.hero-ugc-proof {
  width: min(760px, 70%);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, .25);
  border-radius: 22px;
  background: rgba(8, 10, 9, .58);
  backdrop-filter: blur(14px);
  box-shadow: 0 24px 70px rgba(0, 0, 0, .2);
}

.hero-ugc-proof > div {
  min-height: 116px;
  padding: 23px 25px;
}

.hero-ugc-proof > div + div {
  border-left: 1px solid rgba(255, 255, 255, .17);
}

.hero-ugc-proof strong {
  display: block;
  margin-bottom: 9px;
  color: #fff;
  font-size: clamp(1.35rem, 2.4vw, 2rem);
  line-height: 1;
  letter-spacing: -.04em;
}

.hero-ugc-proof span {
  display: block;
  color: rgba(255, 255, 255, .63);
  font-size: .8rem;
  line-height: 1.4;
}

@keyframes ugc-vertical-loop {
  from { transform: translateY(0); }
  to { transform: translateY(-50%); }
}

@media (max-width: 900px) {
  .hero--ugc,
  .hero-ugc-inner {
    min-height: 780px;
  }

  .ugc-mosaic {
    inset: -8% -24% -12% -2%;
  }

  .hero-ugc-copy,
  .hero-ugc-proof {
    width: min(680px, 90%);
  }

  .hero-ugc-shade {
    background:
      linear-gradient(90deg, rgba(6, 8, 7, .94) 0%, rgba(6, 8, 7, .73) 58%, rgba(6, 8, 7, .42) 100%),
      linear-gradient(180deg, rgba(6, 8, 7, .18) 0%, rgba(6, 8, 7, .1) 52%, rgba(6, 8, 7, .88) 100%);
  }
}

@media (max-width: 560px) {
  .hero--ugc,
  .hero-ugc-inner {
    min-height: 760px;
  }

  .ugc-mosaic {
    inset: -4% -48% -8% -5%;
    grid-template-columns: repeat(3, minmax(180px, 1fr));
    gap: 7px;
  }

  .ugc-loop-set {
    gap: 7px;
    padding-bottom: 7px;
  }

  .hero-ugc-inner {
    padding-top: 58px;
    padding-bottom: 18px;
  }

  .hero-ugc-copy,
  .hero-ugc-proof {
    width: 100%;
  }

  .hero-ugc-body {
    max-width: 92%;
    font-size: .96rem;
  }

  .hero-ugc-proof {
    grid-template-columns: 1fr;
    border-radius: 18px;
  }

  .hero-ugc-proof > div {
    min-height: auto;
    padding: 14px 18px;
    display: grid;
    grid-template-columns: 112px 1fr;
    align-items: center;
    gap: 12px;
  }

  .hero-ugc-proof > div + div {
    border-top: 1px solid rgba(255, 255, 255, .17);
    border-left: 0;
  }

  .hero-ugc-proof strong {
    margin: 0;
    font-size: 1.25rem;
  }

  .hero-ugc-proof span {
    font-size: .76rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .ugc-track { animation: none; }
  .ugc-loop-set:nth-child(2) { display: none; }
}
/* End UGC mosaic hero */

/* Right-side UGC hero layout */
@media (min-width: 901px) {
  .hero--ugc {
    min-height: min(820px, calc(100svh - 78px));
    background: #080a09;
  }

  .ugc-mosaic {
    top: -10%;
    right: 0;
    bottom: -12%;
    left: auto;
    width: 58%;
    gap: 9px;
    overflow: hidden;
    border-radius: 34px 0 0 34px;
    transform: none;
    box-shadow: -30px 0 80px rgba(0, 0, 0, 0.2);
  }

  .ugc-loop-set {
    gap: 9px;
    padding-bottom: 9px;
  }

  .hero-ugc-shade {
    background:
      linear-gradient(
        90deg,
        #080a09 0%,
        #080a09 36%,
        rgba(8, 10, 9, 0.98) 41%,
        rgba(8, 10, 9, 0.83) 49%,
        rgba(8, 10, 9, 0.36) 68%,
        rgba(8, 10, 9, 0.16) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 10, 9, 0.18) 0%,
        rgba(8, 10, 9, 0.04) 50%,
        rgba(8, 10, 9, 0.58) 100%
      );
  }

  .hero-ugc-inner {
    min-height: min(820px, calc(100svh - 78px));
    padding-top: clamp(68px, 9vh, 104px);
    padding-bottom: 34px;
  }

  .hero-ugc-copy {
    width: min(590px, 42%);
    padding-top: 1vh;
  }

  .hero--ugc h1 {
    max-width: 590px;
  }

  .hero-ugc-body {
    max-width: 540px;
  }

  .hero-ugc-proof {
    width: min(700px, 52%);
  }

  .hero-ugc-proof > div {
    min-height: 104px;
    padding: 20px 21px;
  }

  .hero-ugc-proof strong {
    font-size: clamp(1.2rem, 1.8vw, 1.75rem);
  }
}

@media (min-width: 561px) and (max-width: 900px) {
  .ugc-mosaic {
    top: -8%;
    right: -7%;
    bottom: -10%;
    left: auto;
    width: 66%;
    transform: none;
  }

  .hero-ugc-copy {
    width: min(560px, 60%);
  }

  .hero-ugc-proof {
    width: min(650px, 72%);
  }

  .hero-ugc-shade {
    background:
      linear-gradient(
        90deg,
        #080a09 0%,
        rgba(8, 10, 9, 0.96) 38%,
        rgba(8, 10, 9, 0.64) 62%,
        rgba(8, 10, 9, 0.24) 100%
      ),
      linear-gradient(
        180deg,
        rgba(8, 10, 9, 0.12) 0%,
        rgba(8, 10, 9, 0.08) 52%,
        rgba(8, 10, 9, 0.78) 100%
      );
  }
}

@media (max-width: 560px) {
  .ugc-mosaic {
    right: -54%;
    left: auto;
    width: 148%;
    transform: none;
  }
}
/* End right-side UGC hero layout */
